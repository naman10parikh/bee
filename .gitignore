# wikimem
.wikimem-cache/
node_modules/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/hook-fires.log
.claude/audit.jsonl
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

# bee runtime state (the local SQLite dedup ledger + scaffold output)
.bee/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# bee generated run output — observability telemetry (E3) + RSI proposals (D2)
logs/

# bee cockpit generated caches (G1) — regenerated by scripts/serve.sh on every boot; never commit
eval/eval-result.json
web/queue-result.json

# bee cockpit screenshots (G1/G2) — regenerated by `npx playwright test`; evidence, not source
content/screenshots/

.env
